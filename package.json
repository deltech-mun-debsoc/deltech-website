{
  "name": "mun-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:staging": "ALLOW_DESTRUCTIVE_SEED=1 tsx prisma/seed-staging.ts",
    "staging:refresh": "ALLOW_DESTRUCTIVE_SEED=1 node --env-file=.env.staging.local --import tsx prisma/seed-staging.ts",
    "staging:migrate": "node --env-file=.env.staging.local -e \"require('child_process').execFileSync('npx',['prisma','migrate','deploy'],{stdio:'inherit'})\"",
    "staging:sandbox-sheet": "npx tsx scripts/clone-sheet-to-sandbox.ts",
    "check:strings": "node scripts/check-strings.mjs",
    "check": "for f in scripts/check-*.ts; do npx tsx \"$f\" || exit 1; done && node scripts/check-strings.mjs",
    "load:quiz": "tsx scripts/load-quiz.ts",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "build:vercel": "npm run build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/client-sesv2": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-label": "^2.1.15",
    "@react-email/components": "^1.0.12",
    "@tiptap/extension-character-count": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-typography": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-email": "^6.9.5",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.10.1",
    "resend": "^6.26.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
