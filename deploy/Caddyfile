# HTTPS certificates are issued and renewed automatically once DNS points here.
# caddy.env supplies ACME_EMAIL.
{
	email {$ACME_EMAIL}
}

deltechmun.in {
	redir https://www.deltechmun.in{uri} permanent
}

www.deltechmun.in {
	encode zstd gzip
	# Overwrite, never append: the quiz rate limits key on the first entry of
	# X-Forwarded-For, which a client could otherwise choose.
	reverse_proxy prod:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}

test.deltechmun.in {
	encode zstd gzip
	# No password gate: interns need to roam freely, and the app's own sign-in
	# guards everything that matters. X-Robots-Tag keeps it out of search.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy staging:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}
