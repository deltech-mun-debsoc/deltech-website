# The one box: production and staging. HTTPS certificates are issued and renewed
# automatically once DNS points here. caddy.env supplies ACME_EMAIL.
{
	email {$ACME_EMAIL}
}

deltechmun.in {
	redir https://www.deltechmun.in{uri} permanent
}

www.deltechmun.in {
	encode zstd gzip
	# Overwrite, never append: the quiz rate limits key on the first entry of
	# X-Forwarded-For, which a client could otherwise choose.
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}

# The documentation site. Same app container: next.config.ts rewrites this host
# onto /docs, which works because reverse_proxy forwards the original Host
# header upstream. The certificate is issued once DNS for this name points at
# this box; until then Caddy retries on its own and the other sites are
# unaffected.
docs.deltechmun.in {
	encode zstd gzip
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}

# Staging, a separate compose project on this box (compose.staging.yml), reached
# over the mun-edge network as `staging`. Never `app`: that name is production.
test.deltechmun.in {
	encode zstd gzip
	# No password gate: interns need to roam freely, and the app's own sign-in
	# guards everything that matters. X-Robots-Tag keeps it out of search.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy staging:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}
