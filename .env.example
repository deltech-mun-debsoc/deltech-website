# Database (Prisma). Locally, your own Postgres; on a box, its Postgres container.
DATABASE_URL=
DIRECT_URL=

# Auth (next-auth@beta)
AUTH_SECRET=

# Email. "resend" (default) or "ses". SES reads the standard AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY; SES_REGION defaults to ap-south-1.
EMAIL_TRANSPORT=
AUTH_RESEND_KEY=
SES_REGION=
# SES configuration set: suppression list, reputation metrics and bounce
# /complaint events to SNS. Sends work without it, but unmonitored.
SES_CONFIGURATION_SET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=noreply@deltechmun.in
# Optional safety sink. Staging sets this to ADMIN_EMAIL so live-form
# respondents do not receive duplicate test emails.
EMAIL_REDIRECT_TO=

# App
# The origin used in outbound links (status pages, payment links, check-in QR,
# quiz join URLs). PRs run CI only and do not deploy.
#   production  https://deltechmun.in
#   staging     https://test.deltechmun.in
NEXT_PUBLIC_APP_URL=
# "production" or "staging" on the AWS host.
# Drives the "Test site" ribbon and the production-link fallback.
APP_ENV=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin
ADMIN_EMAIL=

# Cron (must match the Authorization: Bearer <value> header).
# Production and staging use different values, so staging cannot trigger
# production's cron routes.
CRON_SECRET=

# Google Form intake (shared secret checked by /api/webhooks/gform;
# same value goes into docs/apps-script/gform-webhook.gs CONFIG.secret)
GFORM_SHARED_SECRET=

# Google Sheet mirror (secret POSTed to the Apps Script web app;
# same value goes into docs/apps-script/sheet-mirror.gs SECRET).
# Staging deliberately shares the production value and public sheet.
SHEET_SYNC_SECRET=

# S3 media uploads (author images, team photos, recruitment documents).
# Server-side only — these are NEVER exposed to the browser, which receives a
# short-lived presigned PUT URL instead. Leave blank to disable uploads entirely.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: CDN / custom domain serving public objects (no trailing slash).
# Defaults to https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_BASE_URL=
# Optional: S3-compatible endpoint for local dev (MinIO, R2, LocalStack).
S3_ENDPOINT=

# AI (Groq — free tier, no billing needed — get key at console.groq.com)
GROQ_API_KEY=
# Optional: override model (default: llama-3.3-70b-versatile)
GROQ_MODEL=

# LiveKit video for online committees. Leave unset to switch video off; the rest
# of the committee floor works without it. For local development:
#   docker compose -f dev/livekit.yml up
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-devsecret
