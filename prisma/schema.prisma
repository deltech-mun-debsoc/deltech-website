// Phase 1 models. URLs live in prisma.config.ts (Prisma v7 — no url in datasource).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Auth (NextAuth / @auth/prisma-adapter) ----

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          Role      @default(AUTHOR)
  passwordHash  String?
  emailVerified DateTime?
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  posts         Post[]

  // Recruitment. `role` above governs which app AREA you may enter; recruitment
  // authority is per-cycle and lives on RecruitmentMember — the two are resolved
  // independently (see src/lib/recruitment/authz.ts).
  recruitmentMemberships RecruitmentMember[]
  recruitedFrom          RecruitmentCandidate? @relation("recruitedUser")
  mediaAssets            MediaAsset[]
}

// SUB_MAINTAINER is the Junior Council account tier: it reaches /recruitment only
// and is structurally locked out of /admin (see roleCanAccess in src/lib/nav.ts).
enum Role {
  ADMIN
  MAINTAINER
  MEMBER
  AUTHOR
  REGISTERER
  SUB_MAINTAINER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Conference config (all editable from dashboard) ----

model StringOverride {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---- Events ----

// An event is a conference, an intra, or anything else the society runs. Before
// this existed, "the event" was a handful of Setting rows and every Committee and
// Delegate belonged to it implicitly, which meant two events could not coexist and
// a student who attended last year collided on Delegate.email.
//
// Modelled on RecruitmentCycle, which already solved the same problem for the
// other half of the product: a row with a state, and children carrying its id.
//
// `kind` is a label for copy only. Nothing branches on it. What an event can do
// lives in the capability flags below, so a new sort of event is configuration
// rather than a new enum value and a dozen new branches.
model Event {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  kind     String     @default("CONFERENCE")
  state    EventState @default(DRAFT)
  startsAt DateTime?
  endsAt   DateTime?

  // Capabilities. These replace the eventMode branches.
  registrationOpen Boolean @default(false)
  paymentsEnabled  Boolean @default(false)
  matrixPublic     Boolean @default(false)

  committees Committee[]
  delegates  Delegate[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@index([state])
}

enum EventState {
  DRAFT
  OPEN
  ALLOTMENT
  LIVE
  CLOSED
  ARCHIVED
}

model Committee {
  id                String        @id @default(cuid())
  eventId           String
  event             Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name              String
  slug              String
  agenda            String?
  aliases           String[]      @default([])
  type              CommitteeType @default(STANDARD)
  doubleDelegation  Boolean       @default(false)
  ebMembers         Json?
  isActive          Boolean       @default(true)
  sortOrder         Int           @default(0)
  portfolioTagLabel String?
  matrixBrief       String?

  // How the committee meets. `type` above is the committee's character; this is
  // its delivery format. Nothing in the schema carried an online/offline
  // distinction before online committees, and `type` must not be overloaded
  // with one: a crisis committee can run either way.
  format CommitteeFormat @default(IN_PERSON)

  portfolios Portfolio[]
  // Allotment.committeeId was a bare string with no relation, so a committee's
  // roster could only be reached by walking Portfolio. Every session feature
  // needs the roster directly.
  allotments Allotment[]
  sessions   CommitteeSession[]
  messages   CommitteeMessage[]

  // When on, a delegate-to-delegate message waits for the dais to approve it
  // before the recipient sees it. Off by default: the dais can always read every
  // DM in its committee either way, so this is about timing, not visibility.
  holdDirectMessages Boolean @default(false)

  @@unique([eventId, slug])
  @@index([eventId])
}

enum CommitteeFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum CommitteeType {
  STANDARD
  CRISIS
  PRESS
}

model Portfolio {
  id            String          @id @default(cuid())
  committeeId   String
  committee     Committee       @relation(fields: [committeeId], references: [id])
  name          String
  tag           String?
  priority      Int             @default(0)
  status        PortfolioStatus @default(AVAILABLE)
  holdToken     String?
  holdExpiresAt DateTime?
  allotment     Allotment?

  // Delegates who asked for this exact seat. Three relations because a delegate
  // states three ranked preferences; see the Delegate model for why the typed
  // name is kept alongside the id.
  pref1Delegates Delegate[] @relation("Pref1Portfolio")
  pref2Delegates Delegate[] @relation("Pref2Portfolio")
  pref3Delegates Delegate[] @relation("Pref3Portfolio")

  attendance       SessionAttendance[]
  speakerEntries   SpeakerEntry[]
  ballots          VoteBallot[]
  messagesSent     CommitteeMessage[]  @relation("MessageFrom")
  messagesReceived CommitteeMessage[]  @relation("MessageTo")

  @@unique([committeeId, name])
  @@index([status])
  @@index([holdExpiresAt])
}

enum PortfolioStatus {
  AVAILABLE
  ON_HOLD
  ALLOTTED
  BLOCKED
}

model Fee {
  id            String  @id @default(cuid())
  label         String
  committeeType String
  isDtu         Boolean @default(false)
  amountInr     Int
}

// ---- Registrations ----

model Delegate {
  id                 String            @id @default(cuid())
  eventId            String
  event              Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  publicToken        String            @unique @default(uuid(4))
  fullName           String
  email              String
  whatsapp           String
  altPhone           String?
  institution        String
  isDtu              Boolean           @default(false)
  munExperience      String?
  source             Source            @default(SELF)
  sourceNote         String?
  // A preference is stored twice on purpose: the id when the delegate picked a
  // real seat from a published matrix, and the name they typed when there was no
  // matrix to pick from. Google Form imports and every row registered before the
  // matrix was published only ever have the text, so the id cannot be relied on
  // alone. Republishing a matrix deletes portfolios and nulls the ids, and the
  // text is what keeps those preferences readable afterwards.
  pref1CommitteeId   String?
  pref1Portfolio     String?
  pref1PortfolioId   String?
  pref1PortfolioRef  Portfolio?        @relation("Pref1Portfolio", fields: [pref1PortfolioId], references: [id], onDelete: SetNull)
  pref2CommitteeId   String?
  pref2Portfolio     String?
  pref2PortfolioId   String?
  pref2PortfolioRef  Portfolio?        @relation("Pref2Portfolio", fields: [pref2PortfolioId], references: [id], onDelete: SetNull)
  pref3CommitteeId   String?
  pref3Portfolio     String?
  pref3PortfolioId   String?
  pref3PortfolioRef  Portfolio?        @relation("Pref3Portfolio", fields: [pref3PortfolioId], references: [id], onDelete: SetNull)
  needsAccommodation Boolean           @default(false)
  outsideNcr         Boolean           @default(false)
  reference          String?
  status             AppStatus         @default(REGISTERED)
  // Kept on the delegate, not derived from the log, so Registrations can filter
  // "never contacted" and "follow-up due" in one indexed query. Every write to the
  // log updates both in the same transaction; see logContact.
  lastContactedAt    DateTime?
  nextFollowUpAt     DateTime?
  contacts           DelegateContact[]
  coDelegate         CoDelegate?
  allotment          Allotment?
  payment            Payment?
  emailLogs          EmailLog[]
  createdAt          DateTime          @default(now())
  checkedInAt        DateTime?
  checkedInBy        String?

  // Intra MUN: DTU roll number from the registration form. Optional because
  // conference delegates are not DTU students.
  rollNumber      String?
  // "Any queries?" from the registration form: a question an organiser owes an
  // answer to. Resolved when someone has replied, so open ones can be listed.
  query           String?
  queryResolvedAt DateTime?

  // Google Sheet sync identity, mirroring RecruitmentCandidate. A delegate created
  // from a response sheet remembers which tab and which row it came from, so a
  // refetch updates it rather than creating a second one, and an unchanged row is
  // skipped. manualEditedFields lists what an organiser changed by hand; a refetch
  // never overwrites those.
  sourceSheetKey     String?
  sourceRowKey       String?
  sourceRowHash      String?
  manualEditedFields String[] @default([])

  @@unique([sourceSheetKey, sourceRowKey])
  @@unique([eventId, email])
  @@index([eventId, nextFollowUpAt])
  @@index([eventId])
  @@index([status])
  @@index([createdAt])
  @@index([status, checkedInAt])
  // Declared here only so Prisma stops proposing to DROP them. They were created
  // by hand in 20260913120000_portfolio_preferences and the names match Prisma's
  // own convention, so schema and database already agree.
  @@index([pref1PortfolioId])
  @@index([pref2PortfolioId])
  @@index([pref3PortfolioId])
}

// ---- Follow-up log ----

// One row per attempt to reach a delegate: a call that was answered, one that
// was not, a WhatsApp, a promise to pay. Append-only on purpose. It is the
// secretariat's shared memory of who has been chased and what they said, and a
// log you can quietly edit is not one anybody can rely on at the desk.
model DelegateContact {
  id         String         @id @default(cuid())
  delegateId String
  delegate   Delegate       @relation(fields: [delegateId], references: [id], onDelete: Cascade)
  outcome    ContactOutcome
  note       String?
  followUpAt DateTime?
  createdBy  String
  createdAt  DateTime       @default(now())

  @@index([delegateId, createdAt])
}

enum ContactOutcome {
  CALLED_REACHED
  CALLED_NO_ANSWER
  CALLED_BUSY
  WRONG_NUMBER
  WHATSAPP_SENT
  EMAIL_SENT
  PROMISED_TO_PAY
  NOT_INTERESTED
  NOTE
}

enum Source {
  SELF
  CROSS_DEL
  SPONSORED
  INTERNAL
  MANUAL
}

enum AppStatus {
  REGISTERED
  ALLOTTED
  PAYMENT_SENT
  CONFIRMED
  CANCELLED
  WAITLISTED
}

model CoDelegate {
  id            String   @id @default(cuid())
  delegateId    String   @unique
  delegate      Delegate @relation(fields: [delegateId], references: [id])
  fullName      String
  email         String
  phone         String
  institution   String?
  munExperience String?
}

model Allotment {
  id          String    @id @default(cuid())
  delegateId  String    @unique
  delegate    Delegate  @relation(fields: [delegateId], references: [id])
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id])
  portfolioId String    @unique
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
  allottedAt  DateTime  @default(now())
  allottedBy  String
  emailSentAt DateTime?

  @@index([committeeId])
}

// ---- Payments ----

model Payment {
  id                String    @id @default(cuid())
  delegateId        String    @unique
  delegate          Delegate  @relation(fields: [delegateId], references: [id])
  provider          String
  amountInr         Int
  status            PayStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  paymentLink       String?
  method            String?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([status])
}

model ImportPreset {
  id        String   @id @default(cuid())
  name      String   @unique
  partner   String?
  mapping   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id         String    @id @default(cuid())
  delegateId String?
  template   String
  toEmail    String
  status     String    @default("SENT")
  error      String?
  sentAt     DateTime  @default(now())
  delegate   Delegate? @relation(fields: [delegateId], references: [id])

  @@index([delegateId])
  @@index([status, sentAt])
}

enum PayStatus {
  PENDING
  SENT
  PAID
  FAILED
  COMPED
  OFFLINE
}

// ---- Society recruitment (GD/PI) ----
//
// Everything is cycle-scoped: closing one cycle cannot touch another's data.
// Candidate stage and result are stored EXPLICITLY rather than inferred from
// missing records, so off-happy-path states (hold, bypass, withdraw, reopen)
// have a home. Sessions are server-authoritative with `version` for optimistic
// concurrency; evaluations are append-only versions, never overwritten.
//
// Partial unique indexes and the audit-immutability trigger cannot be expressed
// in Prisma schema — they live in the migration SQL. See
// prisma/migrations/*_recruitment_module/migration.sql.

model RecruitmentCycle {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  state       CycleState @default(DRAFT)
  // Stage rules + evaluation rubric. Shape validated by RecruitmentCycleConfigSchema
  // in src/lib/schemas/recruitment.ts.
  config      Json       @default("{}")
  // Optimistic lock for concurrent config edits / state transitions.
  version     Int        @default(0)
  openedAt    DateTime?
  closedAt    DateTime?
  finalisedAt DateTime?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  members     RecruitmentMember[]
  candidates  RecruitmentCandidate[]
  groups      RecruitmentGroup[]
  sessions    RecruitmentSession[]
  evaluations RecruitmentEvaluation[]
  sources     RecruitmentSheetSource[]
  imports     RecruitmentImport[]
  handoffs    RecruitmentHandoff[]
  auditEvents RecruitmentAuditEvent[]

  @@index([state])
}

enum CycleState {
  DRAFT
  OPEN
  IN_PROGRESS
  PAUSED
  FINALISATION
  COMPLETED
  ARCHIVED
  CANCELLED
}

// Per-cycle recruitment authority. Deliberately separate from User.role so a
// dashboard MAINTAINER can be a recruitment JC (and vice versa) at the same time.
model RecruitmentMember {
  id           String           @id @default(cuid())
  cycleId      String
  cycle        RecruitmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         RecruitmentRole
  isActive     Boolean          @default(true)
  assignedById String
  assignedAt   DateTime         @default(now())
  revokedAt    DateTime?
  revokedById  String?

  staffAssignments RecruitmentStaffAssignment[]

  @@unique([cycleId, userId])
  @@index([userId, isActive])
}

enum RecruitmentRole {
  JC
  MAINTAINER
  ADMIN
}

// ---- Candidates ----

model RecruitmentCandidate {
  id      String           @id @default(cuid())
  cycleId String
  cycle   RecruitmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  fullName String
  email    String
  phone    String?
  year     String?
  branch   String?

  // Raw imported form row, kept verbatim for the PI dossier.
  formAnswers        Json?
  // Fields a human has edited by hand. Imports never overwrite these.
  manualEditedFields String[]  @default([])
  // Import provenance — makes re-import idempotent and traceable.
  sourceSheetKey     String?
  sourceRowKey       String?
  sourceRowHash      String?
  importedById       String?
  importedAt         DateTime?

  // Explicit pipeline state. `stage` is where they are, `result` is the outcome —
  // two different questions, never conflated.
  stage      CandidateStage  @default(INTAKE)
  result     CandidateResult @default(PENDING)
  // Which stages this candidate actually needs. Direct-to-PI is `gdRequired: false`,
  // a configured shape rather than a missing GD record.
  gdRequired Boolean         @default(true)
  piRequired Boolean         @default(true)
  // Optimistic lock — stale UI cannot overwrite newer state.
  version    Int             @default(0)

  // Finalisation → society. Separate actions: `result` is the decision,
  // recruitedUserId is the membership.
  recruitedUserId String?   @unique
  recruitedUser   User?     @relation("recruitedUser", fields: [recruitedUserId], references: [id])
  recruitedById   String?
  recruitedAt     DateTime?
  memberId        String?
  societyRole     Role?

  decidedById String?
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupMemberships RecruitmentGroupMember[]
  evaluations      RecruitmentEvaluation[]
  handoffs         RecruitmentHandoff[]
  lock             RecruitmentCandidateLock?

  @@unique([cycleId, email])
  @@unique([cycleId, sourceSheetKey, sourceRowKey])
  @@index([cycleId, stage])
  @@index([cycleId, result])
}

enum CandidateStage {
  INTAKE
  GD_PENDING
  GD_ACTIVE
  GD_COMPLETE
  GD_BYPASSED
  PI_PENDING
  PI_ACTIVE
  PI_COMPLETE
  DECISION
  CLOSED
}

enum CandidateResult {
  PENDING
  ON_HOLD
  SELECTED
  REJECTED
  WITHDRAWN
  DISQUALIFIED
}

// ---- Groups & sessions (one shape serves GD and PI) ----

enum SessionKind {
  GD
  PI
}

model RecruitmentGroup {
  id          String           @id @default(cuid())
  cycleId     String
  cycle       RecruitmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  kind        SessionKind
  title       String
  state       GroupState       @default(DRAFT)
  scheduledAt DateTime?
  notes       String?
  version     Int              @default(0)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members  RecruitmentGroupMember[]
  staff    RecruitmentStaffAssignment[]
  sessions RecruitmentSession[]

  @@index([cycleId, kind, state])
}

enum GroupState {
  DRAFT
  READY
  RUNNING
  DONE
  ARCHIVED
}

model RecruitmentGroupMember {
  id          String               @id @default(cuid())
  groupId     String
  group       RecruitmentGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  // Denormalised from the group so the partial unique index in the migration can
  // enforce "one active group per candidate per kind" at the database level.
  kind        SessionKind
  attendance  Attendance           @default(EXPECTED)
  joinedAt    DateTime?
  seat        Int?
  addedById   String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([groupId, candidateId])
  @@index([candidateId])
}

enum Attendance {
  EXPECTED
  PRESENT
  LATE
  ABSENT
  REASSIGNED
}

model RecruitmentStaffAssignment {
  id           String            @id @default(cuid())
  groupId      String
  group        RecruitmentGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId     String
  member       RecruitmentMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // Denormalised from RecruitmentMember at assign time so an evaluation can be
  // attributed to the role the person actually held for this group.
  role         RecruitmentRole
  canEvaluate  Boolean           @default(false)
  assignedById String
  createdAt    DateTime          @default(now())

  @@unique([groupId, memberId])
  @@index([memberId])
}

// Server-authoritative session. Elapsed time is always derived from these
// timestamps (see elapsedMs in src/lib/recruitment/session.ts) — never from a
// browser clock. A reopen creates a NEW row with attempt + 1; the partial unique
// index in the migration guarantees at most one non-terminal session per group.
model RecruitmentSession {
  id      String           @id @default(cuid())
  cycleId String
  cycle   RecruitmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  groupId String
  group   RecruitmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  kind    SessionKind
  attempt Int              @default(1)

  state   SessionState @default(NOT_STARTED)
  // Optimistic lock. Every transition is a conditional update on { id, state, version }.
  version Int          @default(0)

  // Whoever holds operational control. The lease expiry is what lets a second
  // maintainer take over a session whose owner disconnected.
  controllerId     String?
  controlExpiresAt DateTime?

  scheduledAt    DateTime?
  startedAt      DateTime?
  pausedAt       DateTime?
  resumedAt      DateTime?
  endedAt        DateTime?
  // Accumulated paused milliseconds, so elapsed = (endedAt ?? now) - startedAt - pausedMs.
  pausedMs       Int       @default(0)
  lastActivityAt DateTime?
  plannedSeconds Int?

  startedById    String?
  endedById      String?
  abortedById    String?
  abortReason    String?
  reopenedFromId String?
  reopenReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluations RecruitmentEvaluation[]
  locks       RecruitmentCandidateLock[]

  @@unique([groupId, attempt])
  @@index([cycleId, state])
  @@index([cycleId, lastActivityAt])
}

enum SessionState {
  NOT_STARTED
  ACTIVE
  PAUSED
  COMPLETED
  ABORTED
}

// The primary key IS the guarantee: a candidate cannot be live in two sessions.
// Rows are inserted inside the same transaction that starts a session, so a
// conflicting start rolls back rather than producing a double-booked candidate.
model RecruitmentCandidateLock {
  candidateId String               @id
  candidate   RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  sessionId   String
  session     RecruitmentSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cycleId     String
  acquiredAt  DateTime             @default(now())

  @@index([sessionId])
}

// ---- Evaluations (append-only versions) ----

model RecruitmentEvaluation {
  id          String               @id @default(cuid())
  cycleId     String
  cycle       RecruitmentCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind        SessionKind
  groupId     String?
  sessionId   String?
  session     RecruitmentSession?  @relation(fields: [sessionId], references: [id])

  evaluatorId   String
  // The recruitment role the evaluator held when they submitted. Denormalised on
  // purpose: revoking their role later must not rewrite history.
  evaluatorRole RecruitmentRole

  // { criterionKey: number } — criteria come from cycle.config.
  scores         Json            @default("{}")
  overall        Float?
  remarks        String?
  recommendation Recommendation?

  state          EvaluationState @default(DRAFT)
  version        Int             @default(1)
  // Set on the NEW row when it replaces an earlier one; the old row is marked
  // SUPERSEDED in the same transaction. Nothing is ever overwritten.
  supersedesId   String?
  overrideById   String?
  overrideReason String?
  // Client-generated. The @unique turns a network retry into a no-op.
  idempotencyKey String?         @unique

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId, kind, state])
  @@index([cycleId, state])
  @@index([sessionId, evaluatorId])
}

enum EvaluationState {
  DRAFT
  SUBMITTED
  SUPERSEDED
  VOIDED
}

enum Recommendation {
  ADVANCE
  HOLD
  REJECT
  SELECT
  RECONSIDER
}

// ---- Stage transitions / handoff / bypass ----

// Every stage move is recorded here, including the GD bypass. This is what makes
// a direct-to-PI handoff render as "intentionally bypassed" rather than as
// missing GD data.
model RecruitmentHandoff {
  id          String               @id @default(cuid())
  cycleId     String
  cycle       RecruitmentCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  fromStage CandidateStage
  toStage   CandidateStage
  bypass    Boolean        @default(false)
  reason    String?

  actorId   String
  actorRole RecruitmentRole

  sessionId     String?
  evaluationIds String[] @default([])
  previousState Json?
  newState      Json?

  reversedById  String?
  reversedAt    DateTime?
  reverseReason String?

  createdAt DateTime @default(now())

  @@index([candidateId, createdAt])
  @@index([cycleId, createdAt])
}

// ---- Audit (append-only; UPDATE/DELETE blocked by trigger) ----

model RecruitmentAuditEvent {
  id           String            @id @default(cuid())
  cycleId      String?
  cycle        RecruitmentCycle? @relation(fields: [cycleId], references: [id])
  eventType    String
  candidateId  String?
  sessionId    String?
  evaluationId String?
  groupId      String?

  actorId    String?
  actorEmail String
  actorRole  String?

  previousState Json?
  newState      Json?
  reason        String?
  meta          Json?
  // Correlation id, so a retry storm or a partial failure can be reconstructed.
  requestId     String?
  // REJECTED records a permission or state-machine refusal — the spec asks for
  // failed transitions to be auditable, not silently dropped.
  outcome       AuditOutcome @default(SUCCESS)

  at DateTime @default(now())

  @@index([cycleId, at])
  @@index([candidateId, at])
  @@index([eventType, at])
  @@index([outcome, at])
}

enum AuditOutcome {
  SUCCESS
  REJECTED
  FAILED
}

// ---- Google Sheets response import ----

model RecruitmentSheetSource {
  id       String           @id @default(cuid())
  cycleId  String
  cycle    RecruitmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  label    String
  sheetUrl String
  csvUrl   String
  // "<spreadsheetId>:<gid>" — stable identity of the source tab, stored on every
  // candidate row it produced.
  sheetKey String
  // { candidateField: sheetColumnHeader }
  mapping  Json             @default("{}")
  isActive Boolean          @default(true)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  imports RecruitmentImport[]

  @@unique([cycleId, sheetKey])
}

model RecruitmentImport {
  id       String                 @id @default(cuid())
  cycleId  String
  cycle    RecruitmentCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  sourceId String
  source   RecruitmentSheetSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // hash(cycleId, sourceId, mapping, contentHash). Applying the same sheet twice
  // is a no-op that returns the original result.
  idempotencyKey String      @unique
  state          ImportState @default(PENDING)

  rowsTotal   Int @default(0)
  rowsCreated Int @default(0)
  rowsUpdated Int @default(0)
  rowsSkipped Int @default(0)
  rowsInvalid Int @default(0)

  // [{ rowIndex, reason, raw }] — invalid rows are shown, never dropped.
  errors Json?

  importedById String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([cycleId, startedAt])
}

// A Google Form response sheet that delegate registrations are pulled from --
// the Intra MUN registration form. The same shape as RecruitmentSheetSource, but
// not scoped to a recruitment cycle.
model DelegateSheetSource {
  id       String  @id @default(cuid())
  label    String
  sheetUrl String
  csvUrl   String
  // "<spreadsheetId>:<gid>", stored on every delegate the tab produced.
  sheetKey String  @unique
  // { delegateField: sheetColumnHeader }
  mapping  Json    @default("{}")
  isActive Boolean @default(true)

  lastImportedAt DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  imports DelegateImport[]
}

model DelegateImport {
  id       String              @id @default(cuid())
  sourceId String
  source   DelegateSheetSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // Applying the same sheet content twice is a no-op returning the first result.
  idempotencyKey String      @unique
  state          ImportState @default(PENDING)

  rowsTotal   Int @default(0)
  rowsCreated Int @default(0)
  rowsUpdated Int @default(0)
  rowsSkipped Int @default(0)
  rowsInvalid Int @default(0)

  // [{ rowIndex, reason, raw }] -- invalid rows are shown, never dropped.
  errors Json?

  importedById String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([sourceId, startedAt])
}

enum ImportState {
  PENDING
  APPLIED
  FAILED
}

// ---- S3 media ----
//
// Two-phase upload: createUploadIntent writes a PENDING row and hands back a
// presigned PUT; finalizeUpload verifies the object with HeadObject and flips it
// to READY. Rows left PENDING are swept by /api/cron/media-sweep. AWS credentials
// never leave the server.

model MediaAsset {
  id         String @id @default(cuid())
  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  kind      MediaKind
  bucket    String
  objectKey String    @unique
  mimeType  String
  sizeBytes Int
  checksum  String?

  status     MediaStatus     @default(PENDING)
  visibility MediaVisibility @default(PUBLIC)
  publicUrl  String?
  error      String?

  // Free-form owner pointer (postId, memberId, candidateId, ...). Not a FK —
  // media outlives the thing it was attached to.
  ownerType String?
  ownerId   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finalizedAt DateTime?
  deletedAt   DateTime?

  @@index([status, createdAt])
  @@index([uploaderId, createdAt])
  @@index([ownerType, ownerId])
}

enum MediaKind {
  POST_IMAGE
  POST_COVER
  MEMBER_IMAGE
  CANDIDATE_DOC
}

enum MediaStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum MediaVisibility {
  PUBLIC
  SIGNED
}

// ---- Team ----

model Member {
  id            String    @id @default(cuid())
  name          String
  designation   String
  level         TeamLevel @default(JC)
  order         Int       @default(0)
  imageUrl      String?
  photoBytes    Bytes?
  photoMimeType String?
  socials       Json?
  isActive      Boolean   @default(true)
  updatedAt     DateTime  @updatedAt

  @@index([level, order])
}

enum TeamLevel {
  AC
  SC
  JC
}

// ---- Audit ----

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  entity     String
  entityId   String?
  meta       Json?
  at         DateTime @default(now())

  @@index([at])
}

// ---- Rate limiting ----

// DB-backed rather than in-memory: serverless instances do not share memory,
// so a Map would reset on every cold start and be per-instance besides. One
// row per (key, window); old rows are pruned opportunistically.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// ---- Intake quarantine ----

model QuarantinedRow {
  id         String    @id @default(cuid())
  source     String
  presetName String?
  raw        Json
  errors     String[]
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolvedAt])
}

// ---- Blog ----

model Post {
  id          String     @id @default(cuid())
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  title       String
  subtitle    String?
  slug        String     @unique
  coverImage  String?
  contentJson Json
  status      PostStatus @default(DRAFT)
  readMin     Int?
  tags        String[]
  reviewNote  String?
  submittedAt DateTime?
  publishedAt DateTime?

  @@index([authorId])
  @@index([status, publishedAt])
}

enum PostStatus {
  DRAFT
  PENDING
  CHANGES_REQUESTED
  PUBLISHED
  REJECTED
}

// ---- Quiz ----

model Presentation {
  id         String    @id @default(cuid())
  ownerId    String
  title      String
  theme      Json?
  mode       QuizMode  @default(POLL)
  slides     Slide[]
  createdAt  DateTime  @default(now())
  // Archived shows leave the library's main view; nothing else changes.
  archivedAt DateTime?
}

enum QuizMode {
  POLL
  QUIZ
}

model Slide {
  id             String       @id @default(cuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id])
  order          Int
  type           SlideType
  prompt         String
  config         Json

  @@index([presentationId, order])
}

enum SlideType {
  MCQ
  // A two-option MCQ underneath, so the tally, reveal and projected chart all
  // work unchanged; it exists as its own type for the builder's sake.
  TRUE_FALSE
  TYPE_ANSWER
  NUMERIC
  WORDCLOUD
  SCALE
  OPEN_TEXT
  CONTENT
}

model QuizSession {
  id                     String    @id @default(cuid())
  presentationId         String
  roomCode               String    @unique
  status                 String    @default("lobby")
  currentSlideId         String?
  // Server-side clock for speed scoring. The presenter used to only broadcast
  // GOTO over Realtime, so the server had no idea which slide was live or when
  // it started, and had to take the participant's word for how fast they
  // answered. Both columns are written by startSlide().
  currentSlideStartedAt  DateTime?
  // Authoritative question lifecycle. Realtime tells browsers quickly; these
  // fields tell reloads and direct API callers what is actually allowed.
  currentSlideDeadlineAt DateTime?
  currentSlideLockedAt   DateTime?
  currentSlideRevealedAt DateTime?
  startedAt              DateTime?
  endedAt                DateTime?
}

model Response {
  id        String   @id @default(cuid())
  sessionId String
  slideId   String
  nickname  String?
  // Stored so the final leaderboard can show who someone was. It used to live
  // only in the realtime presence channel, so anyone who dropped out before the
  // end appeared as a generic silhouette on the board.
  avatar    String?
  answer    Json
  points    Int      @default(0)
  createdAt DateTime @default(now())

  // The application-level "already submitted" check is a read-then-write, so
  // two taps ~50ms apart both passed it and scored twice. This is the real
  // guard. ponytail: Postgres treats NULLs as distinct, so it covers QUIZ mode
  // (nicknamed, where points matter) and not anonymous POLL votes; add
  // NULLS NOT DISTINCT if anonymous ballot-stuffing ever matters.
  @@unique([sessionId, slideId, nickname])
  @@index([sessionId, slideId])
}

// ---- Mailer ----

// One mail sent to many people: an announcement to delegates, or PR to the
// outreach list. Recipients are resolved when it starts sending, not when it is
// drafted, so a scheduled mail reaches whoever matches the filters on the day.
model MailCampaign {
  id          String          @id @default(cuid())
  eventId     String?
  audience    MailAudience
  filters     Json            @default("{}")
  preset      String          @default("custom")
  subject     String
  body        String
  ctaLabel    String?
  ctaUrl      String?
  state       CampaignState   @default(DRAFT)
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  recipients  MailRecipient[]

  @@index([state, scheduledAt])
}

// One row per person per mail. The unique (campaignId, email) is what makes a
// resumed or overlapping send unable to mail anybody twice.
model MailRecipient {
  id         String          @id @default(cuid())
  campaignId String
  campaign   MailCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email      String
  name       String?
  delegateId String?
  contactId  String?
  status     RecipientStatus @default(PENDING)
  error      String?
  claimedAt  DateTime?
  sentAt     DateTime?

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([status, sentAt])
}

// The outreach list for PR. Separate from Delegate on purpose: a delegate
// registered for an event, a contact only agreed to hear about them, and the two
// must never be mailed on the same terms.
model MailContact {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  institution    String?
  tags           String[]  @default([])
  source         String?
  unsubscribedAt DateTime?
  bouncedAt      DateTime?
  lastMailedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([unsubscribedAt])
}

enum MailAudience {
  DELEGATES
  CONTACTS
}

enum CampaignState {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum RecipientStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

// ---- Online committees (session floor) ----
//
// Modelled on RecruitmentSession, which already solved the hard parts of a
// live, staff-driven session: an optimistic lock so two chairs cannot both
// advance the state, a controller lease so a disconnected chair can be taken
// over, and elapsed time derived on the server rather than from a browser
// clock. Online committee is the same shape with MUN's vocabulary.
//
// SessionState is deliberately NOT reused: that enum belongs to the
// recruitment module, and a value added there should not silently become
// legal for a committee.

model CommitteeSession {
  id          String    @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  // Bumped when a closed session is reopened, so history is kept rather than
  // overwritten. Same role as RecruitmentSession.attempt.
  attempt     Int       @default(1)

  state   CommitteeSessionState @default(NOT_STARTED)
  // Optimistic lock. Every transition is a conditional update on
  // { id, state, version }.
  version Int                   @default(0)

  // The LiveKit room backing the floor. Null for an in-person committee.
  roomName String?

  // Who is driving. Deliberately NOT a lease: recruitment shipped control as a
  // lease that refused everyone else until it lapsed, and backed it out because
  // it locked out the very person trying to finish (see the note in
  // src/lib/recruitment/session.ts). That failure is worse in a live committee,
  // where a chair dropping mid-vote must not freeze the floor. Concurrent
  // drivers are made safe by `version`, not by refusing them.
  controllerId String?

  scheduledAt    DateTime?
  startedAt      DateTime?
  pausedAt       DateTime?
  resumedAt      DateTime?
  endedAt        DateTime?
  // Accumulated paused milliseconds, so
  // elapsed = (endedAt ?? now) - startedAt - pausedMs.
  pausedMs       Int       @default(0)
  lastActivityAt DateTime?
  plannedSeconds Int?

  startedById String?
  endedById   String?
  abortedById String?
  abortReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Default speaking time on the General Speakers' List.
  gslSpeakingSeconds Int @default(90)

  attendance SessionAttendance[]
  speakers   SpeakerEntry[]
  motions    Motion[]
  votes      Vote[]

  @@unique([committeeId, attempt])
  @@index([committeeId, state])
}

enum CommitteeSessionState {
  NOT_STARTED
  ACTIVE
  PAUSED
  COMPLETED
  ABORTED
}

// Roll call, one row per seat per session. Keyed on Portfolio rather than
// Delegate because the thing that is present and votes is the delegation: a
// double-delegated seat has two people and one vote.
//
// Rows are seeded for every portfolio when the session starts, so the roll-call
// screen is a plain query and quorum has a denominator.
model SessionAttendance {
  id        String           @id @default(cuid())
  sessionId String
  session   CommitteeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  status CommitteeAttendance @default(EXPECTED)

  markedAt   DateTime?
  markedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, portfolioId])
  @@index([sessionId, status])
}

// PRESENT and PRESENT_AND_VOTING are a real MUN distinction, not a nicety: a
// delegation that is present and voting gives up the right to abstain on a
// substantive vote. The recruitment Attendance enum has no such concept and
// must not be bent to fit.
enum CommitteeAttendance {
  EXPECTED
  PRESENT
  PRESENT_AND_VOTING
  ABSENT
  LATE
}

// ---- Online committees (chat) ----
//
// One table for every conversation in a committee, told apart by scope:
//   FLOOR  the whole committee, delegates and dais
//   DM     one delegation to another; the dais can read all of them
//   EB     a delegation and the dais, in either direction
//
// There are no private conversations the dais cannot see. At a school
// conference that is a safeguarding requirement, and it is also how note-passing
// has always worked in MUN.
//
// The realtime bus carries a bare "something changed" nudge, never a body:
// every subscriber on a committee channel would otherwise receive other
// delegations' DMs. Clients refetch through an endpoint that filters per
// viewer. See src/lib/committee/chat.ts.

model CommitteeMessage {
  // An integer id doubles as the catch-up cursor. Clients re-read a small
  // overlap behind it, because a lower id can commit after a higher one.
  id Int @id @default(autoincrement())

  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  scope CommitteeMessageScope
  state CommitteeMessageState @default(SENT)

  // Null on the from side means the dais wrote it. SetNull because republishing
  // the matrix deletes portfolios; the labels below keep the record readable.
  fromPortfolioId String?
  fromPortfolio   Portfolio? @relation("MessageFrom", fields: [fromPortfolioId], references: [id], onDelete: SetNull)
  toPortfolioId   String?
  toPortfolio     Portfolio? @relation("MessageTo", fields: [toPortfolioId], references: [id], onDelete: SetNull)
  fromLabel       String
  toLabel         String?

  // The account that actually typed it. A delegation can be two people, and
  // when something goes wrong the dais needs to know which one. Never shown to
  // delegates. A snapshot rather than a relation, so deleting a user account
  // neither fails on nor erases the record.
  authorId    String
  authorEmail String

  body String

  moderatedById String?
  moderatedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([committeeId, id])
}

enum CommitteeMessageScope {
  FLOOR
  DM
  EB
}

enum CommitteeMessageState {
  SENT
  // Waiting for the dais. Only the sender and the dais can see it.
  HELD
  // Removed by the dais. Only the dais can see it.
  BLOCKED
}

// ---- Online committees (the floor) ----
//
// Two kinds of writer, two kinds of safety. The dais changes shared floor state
// (who speaks next, which motion is live, which vote is open), and every such
// change is a transaction conditional on CommitteeSession.version, so a chair
// acting on a stale screen is refused rather than overwriting a colleague.
// Delegates only add their own rows (a request to speak, a motion, a ballot),
// and duplicates are refused by the database itself, never by a read-then-write.

// One place on a speakers list. motionId null is the General Speakers' List; a
// moderated caucus keeps its own list under its motion.
model SpeakerEntry {
  id        String           @id @default(cuid())
  sessionId String
  session   CommitteeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  motionId  String?
  motion    Motion?          @relation(fields: [motionId], references: [id], onDelete: Cascade)

  portfolioId   String
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioName String

  // Set while the entry is QUEUED or SPEAKING, null once it is done. Postgres
  // allows many nulls under a unique index, so this is "one live place per
  // delegation per list" without a partial index Prisma cannot express.
  liveKey String? @unique

  position Int
  state    SpeakerState @default(QUEUED)

  allottedSeconds Int
  startedAt       DateTime?
  pausedAt        DateTime?
  pausedMs        Int       @default(0)
  endedAt         DateTime?

  addedById String
  createdAt DateTime @default(now())

  @@index([sessionId, motionId, state, position])
}

enum SpeakerState {
  QUEUED
  SPEAKING
  SPOKEN
  REMOVED
}

model Motion {
  id        String           @id @default(cuid())
  sessionId String
  session   CommitteeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  kind  MotionKind
  state MotionState @default(PROPOSED)

  // Null when the dais raises it itself.
  proposedByPortfolioId String?
  proposerLabel         String
  topic                 String?
  totalSeconds          Int?
  speakingSeconds       Int?

  // The caucus clock, once a passed motion is under way.
  startedAt DateTime?
  pausedAt  DateTime?
  pausedMs  Int       @default(0)
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  speakers SpeakerEntry[]
  vote     Vote?

  @@index([sessionId, state])
}

enum MotionKind {
  MODERATED_CAUCUS
  UNMODERATED_CAUCUS
  EXTEND
  CLOSE_DEBATE
  OTHER
}

enum MotionState {
  PROPOSED
  VOTING
  PASSED
  FAILED
  WITHDRAWN
  RULED_OUT
  IN_PROGRESS
  ENDED
}

model Vote {
  id        String           @id @default(cuid())
  sessionId String
  session   CommitteeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // A procedural vote on a motion; null for a substantive vote on a draft.
  motionId  String?          @unique
  motion    Motion?          @relation(fields: [motionId], references: [id], onDelete: Cascade)

  subject  String
  kind     VoteKind
  majority VoteMajority @default(SIMPLE)
  state    VoteState    @default(OPEN)

  // Delegations present when the vote opened: the denominator the dais reads.
  eligible Int
  yes      Int      @default(0)
  no       Int      @default(0)
  abstain  Int      @default(0)
  passed   Boolean?

  openedById String
  openedAt   DateTime  @default(now())
  closedById String?
  closedAt   DateTime?

  ballots VoteBallot[]

  @@index([sessionId, state])
}

enum VoteKind {
  PROCEDURAL
  SUBSTANTIVE
}

enum VoteMajority {
  SIMPLE
  TWO_THIRDS
}

enum VoteState {
  OPEN
  CLOSED
}

// One per delegation per vote, enforced by the unique index: a double click, a
// retry, or two co-delegates voting at once cannot count twice.
model VoteBallot {
  id          String       @id @default(cuid())
  voteId      String
  vote        Vote         @relation(fields: [voteId], references: [id], onDelete: Cascade)
  portfolioId String
  portfolio   Portfolio    @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  choice      BallotChoice
  castById    String
  castByEmail String
  castAt      DateTime     @default(now())

  @@unique([voteId, portfolioId])
}

enum BallotChoice {
  YES
  NO
  ABSTAIN
}
