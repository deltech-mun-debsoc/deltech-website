{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "regions": ["syd1"],
  "crons": [
    {
      "path": "/api/cron/payment-reminder",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/gform-sync",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/media-sweep",
      "schedule": "0 4 * * *"
    }
  ]
}
